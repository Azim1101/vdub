            android:fillColor="#12131A"
            android:pathData="M38.6,39.9 L45.4,38.3 L49.3,46.5 L42.5,48.1 Z" />
        <path
            android:fillColor="#12131A"
            android:pathData="M53.9,36.3 L60.7,34.7 L64.6,42.9 L57.8,44.5 Z" />
        <path
            android:fillColor="#12131A"
            android:pathData="M69.2,32.7 L76.0,31.1 L79.9,39.3 L73.1,40.9 Z" />
    </group>

    <!-- board body -->
    <path
        android:fillColor="#7C5CFF"
        android:pathData="M28,50 L80,50 A4,4 0 0,1 84,54 L84,78 A4,4 0 0,1 80,82 L28,82 A4,4 0 0,1 24,78 L24,54 A4,4 0 0,1 28,50 Z" />

