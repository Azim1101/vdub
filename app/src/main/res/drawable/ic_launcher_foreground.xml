    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- clapper top bar, angled -->
    <group android:pivotX="54" android:pivotY="54">
        <path
            android:fillColor="#7C5CFF"
            android:pathData="M27.5,40.6 L76.5,29.2 A3,3 0 0,1 80.1,31.5 L82.2,40.6 A3,3 0 0,1 79.9,44.2 L30.9,55.6 A3,3 0 0,1 27.3,53.3 L25.2,44.2 A3,3 0 0,1 27.5,40.6 Z" />
