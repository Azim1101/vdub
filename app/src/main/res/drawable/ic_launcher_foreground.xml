<?xml version="1.0" encoding="utf-8"?>
<!--
  vdub launcher icon: clapperboard + waveform.
  Adaptive-icon foreground. The 108dp canvas has a 72dp safe zone centred at
  54,54 — art stays inside it so no launcher mask clips the clapper.
-->
